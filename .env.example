# King's Palworld Manager end-user environment template
# Copy to .env next to compose.yaml. Never commit .env.

KPM_IMAGE_TAG=latest
KPM_BIND_ADDRESS=127.0.0.1
KPM_HTTP_PORT=8080

TZ=UTC

KPM_SERVER_NAME=King's Palworld Server
KPM_SERVER_PASSWORD=
KPM_ADMIN_PASSWORD=change-me-before-deployment
KPM_MAX_PLAYERS=16
KPM_COMMUNITY=false
KPM_CROSSPLAY_PLATFORMS=(Steam,Xbox,PS5,Mac)

KPM_PALWORLD_PUBLIC_PORT=8211
KPM_PALWORLD_QUERY_PORT=27015
KPM_STEAM_APP_ID=1623730
