KPM_BIND_ADDRESS=127.0.0.1
KPM_HTTP_PORT=8080

# Manager persistence
KPM_DATA_PATH=/manager/data
KPM_DB_FILENAME=kpm.db

# Production WebGUI build
KPM_WEB_ROOT=/app/web

# Palworld installation managed by KPM
KPM_PALWORLD_ROOT=/pal/Package

KPM_PALWORLD_GAME_PORT=8211
KPM_PALWORLD_QUERY_PORT=27015
KPM_PALWORLD_REST_PORT=8212
KPM_PALWORLD_STOP_TIMEOUT_MS=30000
KPM_PALWORLD_REST_USERNAME=admin
KPM_PALWORLD_REST_TIMEOUT_MS=5000
KPM_PALWORLD_REST_SHUTDOWN_WAIT_SECONDS=1

# Container bootstrap
# 1 = check/install/update Palworld before Manager startup
# 0 = skip updates when an installation already exists
KPM_STEAM_UPDATE_ON_START=1